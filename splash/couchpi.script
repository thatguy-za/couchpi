# CouchPi boot splash: black screen, wordmark, three softly pulsing dots.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

title_img = Image.Text("CouchPi", 1, 1, 1, 1, "Sans Bold 64");
title = Sprite(title_img);
title.SetX(cx - title_img.GetWidth() / 2);
title.SetY(cy - title_img.GetHeight() / 2 - 20);

dot_img = Image.Text("●", 0.6, 0.65, 0.85, 1, "Sans 20");
for (i = 0; i < 3; i++) {
    dot[i] = Sprite(dot_img);
    dot[i].SetX(cx + (i - 1) * 48 - dot_img.GetWidth() / 2);
    dot[i].SetY(cy + title_img.GetHeight() / 2 + 20);
}

frame = 0;
fun refresh() {
    frame++;
    for (i = 0; i < 3; i++) {
        phase = frame / 60 * 6.2832 / 1.4 - i * 0.9;
        dot[i].SetOpacity(0.2 + 0.8 * (0.5 + 0.5 * Math.Sin(phase)));
    }
}
Plymouth.SetRefreshFunction(refresh);
