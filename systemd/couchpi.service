[Unit]
Description=CouchPi launcher (kiosk session on tty1)
After=systemd-user-sessions.service plymouth-quit.service plymouth-quit-wait.service getty@tty1.service systemd-logind.service seatd.service
Wants=dbus.socket systemd-logind.service seatd.service
Conflicts=getty@tty1.service
Before=graphical.target
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User=couchpi
AmbientCapabilities=
ExecStart=/opt/couchpi/bin/couchpi-session
Restart=always
RestartSec=2
UtmpIdentifier=tty1
UtmpMode=user
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
PAMName=couchpi

[Install]
WantedBy=graphical.target
