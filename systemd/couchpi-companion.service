[Unit]
Description=CouchPi phone companion (keyboard, remote and touchpad over Wi-Fi)
After=network-online.target
Wants=network-online.target

[Service]
User=couchpi
SupplementaryGroups=input
ExecStart=/usr/bin/python3 /opt/couchpi/companion/server.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/couchpi /var/lib/couchpi

[Install]
WantedBy=multi-user.target
