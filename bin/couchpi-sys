#!/usr/bin/env python3
"""Privileged system helper for the CouchPi settings screen (run via sudo).

  couchpi-sys wifi-list                    JSON list of nearby networks
  couchpi-sys wifi-connect <ssid>          password on stdin (empty for open networks)
  couchpi-sys set-hostname <name>
  couchpi-sys bt-scan                      scan ~8s, JSON list of Bluetooth devices
  couchpi-sys bt <pair|connect|disconnect|forget> <mac>
Always prints one JSON document on stdout.
"""
import json
import re
import subprocess
import sys


def split_nm(line):
    """Split an `nmcli -t` line on unescaped colons."""
    parts = re.split(r"(?<!\\):", line)
    return [p.replace("\\:", ":").replace("\\\\", "\\") for p in parts]


def wifi_list():
    out = subprocess.run(
        ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "yes"],
        capture_output=True, text=True, timeout=45).stdout
    best = {}
    for line in out.splitlines():
        f = split_nm(line)
        if len(f) < 4 or not f[1]:
            continue
        net = {"ssid": f[1], "signal": int(f[2] or 0), "secure": f[3] not in ("", "--"),
               "active": f[0].strip() == "*"}
        old = best.get(net["ssid"])
        if not old or net["active"] or (not old["active"] and net["signal"] > old["signal"]):
            best[net["ssid"]] = net
    return sorted(best.values(), key=lambda n: (not n["active"], -n["signal"]))


def wifi_connect(ssid):
    pw = sys.stdin.read().rstrip("\n")
    subprocess.run(["nmcli", "connection", "delete", "id", ssid], capture_output=True)
    cmd = ["nmcli", "dev", "wifi", "connect", ssid] + (["password", pw] if pw else [])
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    if r.returncode == 0:
        return {"ok": True, "msg": f"Connected to {ssid}"}
    err = (r.stderr or r.stdout).strip().splitlines()
    return {"ok": False, "msg": err[-1] if err else "Could not connect"}


def set_hostname(name):
    if not re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?", name):
        return {"ok": False, "msg": "Use letters, numbers and dashes only"}
    subprocess.run(["hostnamectl", "set-hostname", name], check=True)
    subprocess.run(["sed", "-i", "-E", f"s/^127\\.0\\.1\\.1.*/127.0.1.1\\t{name}/", "/etc/hosts"])
    return {"ok": True, "msg": f"Device name is now {name}"}


MAC_RE = re.compile(r"[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}")
KINDS = {"audio": "Audio", "input-gaming": "Controller", "input-keyboard": "Keyboard",
         "input-mouse": "Mouse", "input-tablet": "Remote", "phone": "Phone", "computer": "Computer"}


def bt(*args, timeout=30):
    return subprocess.run(["bluetoothctl", *args], capture_output=True, text=True, timeout=timeout).stdout


def bt_scan():
    subprocess.run(["rfkill", "unblock", "bluetooth"], capture_output=True)
    bt("power", "on")
    bt("--timeout", "8", "scan", "on", timeout=25)
    devs = []
    for line in bt("devices").splitlines():
        m = re.match(r"Device (\S{17}) (.*)", line)
        if not m or re.fullmatch(r"([0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}", m.group(2)):
            continue  # skip nameless devices
        info = bt("info", m.group(1))
        icon = re.search(r"Icon: (\S+)", info)
        kind = next((v for k, v in KINDS.items() if icon and icon.group(1).startswith(k)), "")
        devs.append({"mac": m.group(1), "name": m.group(2), "kind": kind,
                     "paired": "Paired: yes" in info, "connected": "Connected: yes" in info})
    return sorted(devs, key=lambda d: (not d["connected"], not d["paired"], d["name"].lower()))


def bt_action(action, mac):
    if not MAC_RE.fullmatch(mac):
        return {"ok": False, "msg": "bad address"}
    if action == "forget":
        bt("remove", mac)
        return {"ok": True, "msg": "Device forgotten"}
    if action == "disconnect":
        bt("disconnect", mac)
        return {"ok": True, "msg": "Disconnected"}
    if action == "pair":
        bt("--timeout", "30", "pair", mac, timeout=45)
        bt("trust", mac)
    out = bt("connect", mac, timeout=40)
    ok = "Connection successful" in out
    return {"ok": ok, "msg": "Connected" if ok else "Could not connect (is the device in pairing mode?)"}


def main(argv):
    try:
        if argv[1:2] == ["bt-scan"]:
            print(json.dumps(bt_scan()))
            return
        if argv[1:2] == ["bt"] and len(argv) == 4 and argv[2] in ("pair", "connect", "disconnect", "forget"):
            print(json.dumps(bt_action(argv[2], argv[3])))
            return
        if argv[1:2] == ["wifi-list"]:
            print(json.dumps(wifi_list()))
        elif argv[1:2] == ["wifi-connect"] and len(argv) == 3:
            print(json.dumps(wifi_connect(argv[2])))
        elif argv[1:2] == ["set-hostname"] and len(argv) == 3:
            print(json.dumps(set_hostname(argv[2])))
        else:
            print(json.dumps({"ok": False, "msg": "bad command"}))
    except (OSError, subprocess.SubprocessError) as e:
        print(json.dumps({"ok": False, "msg": str(e)}))


if __name__ == "__main__":
    main(sys.argv)
