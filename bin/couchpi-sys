#!/usr/bin/env python3
"""Privileged system helper for the CouchPi settings screen (run via sudo).

  couchpi-sys wifi-list                    JSON list of nearby networks
  couchpi-sys wifi-connect <ssid>          password on stdin (empty for open networks)
  couchpi-sys set-hostname <name>
  couchpi-sys bt-scan                      scan ~8s, JSON list of Bluetooth devices
  couchpi-sys bt <connect|disconnect|forget> <mac>
  couchpi-sys bt-pair <mac>                interactive pairing (PIN/passkey); JSON events on stdout,
                                           answers on stdin, closing stdin cancels
Always prints one JSON document on stdout.
"""
import json
import re
import subprocess
import sys


def split_nm(line):
    """Split an `nmcli -t` line on unescaped colons."""
    parts = re.split(r"(?<!\\):", line)
    return [p.replace("\\:", ":").replace("\\\\", "\\") for p in parts]


def wifi_list():
    out = subprocess.run(
        ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "yes"],
        capture_output=True, text=True, timeout=45).stdout
    best = {}
    for line in out.splitlines():
        f = split_nm(line)
        if len(f) < 4 or not f[1]:
            continue
        net = {"ssid": f[1], "signal": int(f[2] or 0), "secure": f[3] not in ("", "--"),
               "active": f[0].strip() == "*"}
        old = best.get(net["ssid"])
        if not old or net["active"] or (not old["active"] and net["signal"] > old["signal"]):
            best[net["ssid"]] = net
    return sorted(best.values(), key=lambda n: (not n["active"], -n["signal"]))


def wifi_connect(ssid):
    pw = sys.stdin.read().rstrip("\n")
    subprocess.run(["nmcli", "connection", "delete", "id", ssid], capture_output=True)
    cmd = ["nmcli", "dev", "wifi", "connect", ssid] + (["password", pw] if pw else [])
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    if r.returncode == 0:
        return {"ok": True, "msg": f"Connected to {ssid}"}
    err = (r.stderr or r.stdout).strip().splitlines()
    return {"ok": False, "msg": err[-1] if err else "Could not connect"}


def set_hostname(name):
    if not re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?", name):
        return {"ok": False, "msg": "Use letters, numbers and dashes only"}
    subprocess.run(["hostnamectl", "set-hostname", name], check=True)
    subprocess.run(["sed", "-i", "-E", f"s/^127\\.0\\.1\\.1.*/127.0.1.1\\t{name}/", "/etc/hosts"])
    return {"ok": True, "msg": f"Device name is now {name}"}


MAC_RE = re.compile(r"[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}")
KINDS = {"audio": "Audio", "input-gaming": "Controller", "input-keyboard": "Keyboard",
         "input-mouse": "Mouse", "input-tablet": "Remote", "phone": "Phone", "computer": "Computer"}


def bt(*args, timeout=30):
    return subprocess.run(["bluetoothctl", *args], capture_output=True, text=True, timeout=timeout).stdout


def bt_scan():
    subprocess.run(["rfkill", "unblock", "bluetooth"], capture_output=True)
    bt("power", "on")
    bt("--timeout", "8", "scan", "on", timeout=25)
    devs = []
    for line in bt("devices").splitlines():
        m = re.match(r"Device (\S{17}) (.*)", line)
        if not m or re.fullmatch(r"([0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}", m.group(2)):
            continue  # skip nameless devices
        info = bt("info", m.group(1))
        icon = re.search(r"Icon: (\S+)", info)
        kind = next((v for k, v in KINDS.items() if icon and icon.group(1).startswith(k)), "")
        devs.append({"mac": m.group(1), "name": m.group(2), "kind": kind,
                     "paired": "Paired: yes" in info, "connected": "Connected: yes" in info})
    return sorted(devs, key=lambda d: (not d["connected"], not d["paired"], d["name"].lower()))


def bt_action(action, mac):
    if not MAC_RE.fullmatch(mac):
        return {"ok": False, "msg": "bad address"}
    if action == "forget":
        bt("remove", mac)
        return {"ok": True, "msg": "Device forgotten"}
    if action == "disconnect":
        bt("disconnect", mac)
        return {"ok": True, "msg": "Disconnected"}
    if action == "pair":
        bt("--timeout", "30", "pair", mac, timeout=45)
        bt("trust", mac)
    out = bt("connect", mac, timeout=40)
    ok = "Connection successful" in out
    return {"ok": ok, "msg": "Connected" if ok else "Could not connect (is the device in pairing mode?)"}


BT_PATTERNS = [
    ("paired", r"Pairing successful"),
    ("fail", r"Failed to pair: (\S+)"),
    ("request_pin", r"Enter PIN code:"),
    ("request_passkey", r"Enter passkey"),
    ("display_pin", r"\[agent\] PIN code: (\S+)"),
    ("display_passkey", r"\[agent\] Passkey: (\d+)"),
    ("confirm", r"Confirm passkey (\d+)"),
    ("authorize", r"(?:Accept pairing|Authorize service)[^\n]*\(yes/no\)"),
    ("connected", r"Connection successful"),
    ("connfail", r"Failed to connect: (\S+)"),
]
BT_ERRORS = {"AuthenticationFailed": "Wrong PIN, or the device refused", "AuthenticationTimeout": "Timed out waiting for the device",
             "AuthenticationCanceled": "Pairing cancelled", "ConnectionAttemptFailed": "Device didn't answer"}


def bt_pair_stream(mac):
    """Interactive pairing. Prints one JSON event per line; reads answers (PIN / yes / no)
    from stdin. Closing stdin cancels. Events: display_passkey, display_pin, confirm,
    request_pin, request_passkey, result."""
    import os
    import pty
    import select
    import termios
    import time

    def emit(**kw):
        print(json.dumps(kw), flush=True)

    if not MAC_RE.fullmatch(mac):
        return emit(event="result", ok=False, msg="bad address")
    subprocess.run(["rfkill", "unblock", "bluetooth"], capture_output=True)
    master, slave = pty.openpty()
    attrs = termios.tcgetattr(slave)
    attrs[3] &= ~termios.ECHO
    termios.tcsetattr(slave, termios.TCSANOW, attrs)
    proc = subprocess.Popen(["bluetoothctl"], stdin=slave, stdout=slave, stderr=slave, close_fds=True)
    os.close(slave)

    def send(s):
        os.write(master, (s + "\n").encode())

    for c in ("power on", "pairable on", "agent KeyboardDisplay", "default-agent", f"pair {mac}"):
        send(c)
    ansi = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|[\x01\x02]")
    buf, waiting, last_code, result = "", None, None, None
    paired = False
    deadline = time.time() + 120
    stdin_open = True

    def finish_pairing():
        nonlocal paired
        paired = True
        send(f"trust {mac}")
        send(f"connect {mac}")

    while result is None and time.time() < deadline:
        r, _, _ = select.select([master] + ([sys.stdin] if stdin_open else []), [], [], 0.5)
        if master in r:
            try:
                data = os.read(master, 4096)
            except OSError:
                break
            buf += ansi.sub("", data.decode(errors="ignore")).replace("\r", "")
            while True:
                best = None
                for name, rx in BT_PATTERNS:
                    m = re.search(rx, buf)
                    if m and (best is None or m.start() < best[1].start()):
                        best = (name, m)
                if not best:
                    break
                name, m = best
                buf = buf[m.end():]
                if name == "paired":
                    finish_pairing()
                elif name == "fail":
                    if m.group(1).endswith("AlreadyExists"):
                        finish_pairing()
                    else:
                        result = (False, BT_ERRORS.get(m.group(1).split(".")[-1], "Pairing failed"))
                elif name in ("request_pin", "request_passkey"):
                    waiting = "pin"
                    emit(event=name)
                elif name in ("display_pin", "display_passkey", "confirm"):
                    if name == "confirm":
                        waiting = "yes"
                    if (name, m.group(1)) != last_code:
                        last_code = (name, m.group(1))
                        emit(event=name, code=m.group(1))
                elif name == "authorize":
                    send("yes")
                elif name == "connected":
                    result = (True, "Paired and connected")
                elif name == "connfail":
                    result = (paired, "Paired, but could not connect" if paired else "Could not connect")
        if sys.stdin in r:
            line = sys.stdin.readline()
            if not line:
                stdin_open = False
                result = (False, "Pairing cancelled")
                break
            ans = line.strip()
            if waiting == "pin" and re.fullmatch(r"[0-9A-Za-z]{1,16}", ans):
                send(ans)
            elif waiting == "yes":
                send("yes" if ans == "yes" else "no")
            waiting = None
    if result is None:
        result = (False, "Timed out")
    if not result[0] or "Paired" not in result[1]:
        send(f"cancel-pairing {mac}")
    send("quit")
    try:
        proc.wait(3)
    except subprocess.TimeoutExpired:
        proc.kill()
    emit(event="result", ok=result[0], msg=result[1])


def main(argv):
    try:
        if argv[1:2] == ["bt-pair"] and len(argv) == 3:
            bt_pair_stream(argv[2])
            return
        if argv[1:2] == ["bt-scan"]:
            print(json.dumps(bt_scan()))
            return
        if argv[1:2] == ["bt"] and len(argv) == 4 and argv[2] in ("pair", "connect", "disconnect", "forget"):
            print(json.dumps(bt_action(argv[2], argv[3])))
            return
        if argv[1:2] == ["wifi-list"]:
            print(json.dumps(wifi_list()))
        elif argv[1:2] == ["wifi-connect"] and len(argv) == 3:
            print(json.dumps(wifi_connect(argv[2])))
        elif argv[1:2] == ["set-hostname"] and len(argv) == 3:
            print(json.dumps(set_hostname(argv[2])))
        else:
            print(json.dumps({"ok": False, "msg": "bad command"}))
    except (OSError, subprocess.SubprocessError) as e:
        print(json.dumps({"ok": False, "msg": str(e)}))


if __name__ == "__main__":
    main(sys.argv)
