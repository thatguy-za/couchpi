#!/usr/bin/env python3
"""CouchPi updater (run as root).

  couchpi-update check                    refresh /run/couchpi/update.json
  couchpi-update run <os|jellyfin|chiaki|couchpi|all> [security]
  couchpi-update auto                     what the daily timer runs (honours settings)
"""
import fcntl
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.request

APP_DIR = "/opt/couchpi"
CONF = os.environ.get("COUCHPI_CONFIG", "/etc/couchpi/config.json")
RUN_DIR = "/run/couchpi"
STATUS, LOG = f"{RUN_DIR}/update.json", f"{RUN_DIR}/update.log"
STATE_DIR = "/var/lib/couchpi"
FLATPAKS = {"jellyfin": "org.jellyfin.JellyfinDesktop", "chiaki": "io.github.streetpea.Chiaki4deck"}
ENV = dict(os.environ, DEBIAN_FRONTEND="noninteractive", LC_ALL="C")


def log(msg):
    print(msg, flush=True)
    os.makedirs(RUN_DIR, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(msg + "\n")


def cfg():
    try:
        with open(CONF) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def sh(cmd, check=False, **kw):
    return subprocess.run(cmd, env=ENV, capture_output=True, text=True, check=check, **kw)


def stream(cmd):
    """Run a command, mirroring its last output lines into the log for the UI."""
    p = subprocess.Popen(cmd, env=ENV, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in p.stdout:
        line = line.strip()
        if line:
            log(line[:90])
    return p.wait()


def repo():
    try:
        return open(f"{APP_DIR}/repo").read().strip()
    except OSError:
        return ""


def remote_sha():
    r = repo()
    if not r:
        return None
    req = urllib.request.Request(f"https://api.github.com/repos/{r}/commits/main",
                                 headers={"Accept": "application/vnd.github.sha", "User-Agent": "couchpi"})
    try:
        return urllib.request.urlopen(req, timeout=20).read().decode().strip()
    except OSError:
        return None


def local_sha():
    try:
        return open(f"{APP_DIR}/.commit").read().strip()
    except OSError:
        return ""


def check():
    log("Checking for updates...")
    sh(["apt-get", "-o", "DPkg::Lock::Timeout=600", "update", "-qq"])
    sim = [l for l in sh(["apt-get", "-s", "upgrade"]).stdout.splitlines() if l.startswith("Inst ")]
    status = {
        "checked": int(time.time()),
        "os": {"total": len(sim), "security": sum("-security" in l or "Security" in l for l in sim)},
        "reboot_required": os.path.exists("/var/run/reboot-required"),
    }
    pending = sh(["flatpak", "remote-ls", "--updates", "--columns=application"]).stdout.split()
    for key, app in FLATPAKS.items():
        status[key] = app in pending
    rs = remote_sha()
    status["couchpi"] = bool(rs and rs != local_sha())
    os.makedirs(RUN_DIR, exist_ok=True)
    with open(STATUS, "w") as f:
        json.dump(status, f)
    os.chmod(STATUS, 0o644)
    log("Check finished.")


def update_os(scope):
    if scope == "security":
        log("Installing security updates...")
        stream(["unattended-upgrade", "-v"])
    else:
        log("Updating the operating system...")
        stream(["apt-get", "-y", "-o", "DPkg::Lock::Timeout=600", "-o", "Dpkg::Options::=--force-confold", "upgrade"])


def update_flatpak(key):
    log(f"Updating {key}...")
    stream(["flatpak", "update", "-y", "--noninteractive", FLATPAKS[key]])


def update_couchpi():
    r = repo()
    if not r:
        log("No repository configured; skipping CouchPi update.")
        return
    log("Updating CouchPi...")
    sha = remote_sha()
    with tempfile.TemporaryDirectory() as tmp:
        tar = f"{tmp}/src.tar.gz"
        urllib.request.urlretrieve(f"https://github.com/{r}/archive/refs/heads/main.tar.gz", tar)
        sh(["tar", "xzf", tar, "-C", tmp], check=True)
        src = next(d for d in os.listdir(tmp) if os.path.isdir(f"{tmp}/{d}"))
        env = dict(ENV, COUCHPI_UPDATE="1", COUCHPI_REPO=r)
        rc = subprocess.run(["bash", f"{tmp}/{src}/install.sh"], env=env).returncode
    if rc == 0 and sha:
        open(f"{APP_DIR}/.commit", "w").write(sha)
        log("CouchPi updated; restarting.")
        subprocess.Popen(["systemctl", "restart", "couchpi-cec.service", "couchpi.service"])
    else:
        log("CouchPi update failed.")


def run(target, scope="all"):
    if target in ("os", "all"):
        update_os(scope)
    for key in FLATPAKS:
        if target in (key, "all"):
            update_flatpak(key)
    if target in ("couchpi", "all"):
        update_couchpi()
    check()
    log("All done.")


def auto():
    c = cfg()
    os.makedirs(STATE_DIR, exist_ok=True)
    stamp = f"{STATE_DIR}/last_auto"
    if c.get("auto_frequency", "daily") == "weekly":
        try:
            if time.time() - os.path.getmtime(stamp) < 6.5 * 86400:
                return
        except OSError:
            pass
    if c.get("auto_os", "security") != "off":
        update_os(c.get("auto_os", "security"))
    for key in FLATPAKS:
        if c.get(f"auto_{key}"):
            update_flatpak(key)
    open(stamp, "w").close()
    if c.get("auto_couchpi"):
        update_couchpi()  # last: it restarts the launcher
    check()


def main(argv):
    lock = open("/run/couchpi-update.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("another update is already running")
    if os.path.exists(LOG) and argv[1:2] != ["auto"]:
        open(LOG, "w").close()
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "check":
        check()
    elif cmd == "run" and len(argv) > 2:
        run(argv[2], argv[3] if len(argv) > 3 else "all")
    elif cmd == "auto":
        auto()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
